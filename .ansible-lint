---
profile: basic

# plugins/, roles/, playbooks/ and the integration targets are all linted.
# The integration suite is the only place some of this collection's behaviour
# is exercised end to end, so it is held to the same standard as the content
# it tests.
exclude_paths:
  - .ansible/
  - .git/
  - .venv/
  - changelogs/
  - mkdocs.yml

skip_list:
  # Renaming the crdp role's public variables to a crdp_ prefix would break
  # every existing playbook that sets them. Deferred to 2.0.0, which already
  # carries the camelCase -> snake_case parameter migration.
  - var-naming[no-role-prefix]
