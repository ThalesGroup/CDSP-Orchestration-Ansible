---
cm_connection_string:
  server_ip: 192.168.2.100
  user: admin
  password: ChangeIt01!
  verify: false
  auth_domain_path:
# Id of a local CA on the target CipherTrust Manager, used to sign client
# profile certificates. Every manager has its own -- read it from
# GET /v1/ca/local-cas; the value below is an example and will not exist on
# your manager.
local_ca_id: "146b5095-8f9b-47c6-a43c-a6ee4b58b23b"

# Port the DPG target creates its NAE interface on. It must be free: the
# target builds the interface itself, because a DPG client profile requires
# tls-cert-pw-opt mode and any interface already on the port is unlikely to
# have it.
nae_interface_port_number: 9005
# Unlike localNode, cm_cluster's `nodes` suboptions genuinely require
# server_private_ip and server_port -- they describe the joining node to the
# cluster API rather than the connection this collection makes.
cluster_nodes:
  - server_ip: 192.168.2.101
    server_private_ip: 10.10.10.10
    server_port: 5432
    user: admin
    password: ChangeIt01!
    verify: false
    auth_domain_path:

# cm_services can only restart CipherTrust Manager, which interrupts every
# task that follows. Set this to run that test for real; by default the
# module is exercised in check mode only.
cm_allow_disruptive_tests: false

# Some targets create objects this collection cannot delete (a domain, for
# example). They are skipped unless this is set.
cm_allow_uncleanable_tests: false
