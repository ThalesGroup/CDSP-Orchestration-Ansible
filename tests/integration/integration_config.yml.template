---
cm_connection_string:
  server_ip: 192.168.2.100
  user: admin
  password: ChangeIt01!
  verify: false
  auth_domain_path:
# Id of a local CA on the target CipherTrust Manager, used to sign client
# profile certificates. Every manager has its own -- read it from
# GET /v1/ca/local-cas; the value below is an example and will not exist on
# your manager.
local_ca_id: "146b5095-8f9b-47c6-a43c-a6ee4b58b23b"

# Port the DPG target creates its NAE interface on. It must be free: the
# target builds the interface itself, because a DPG client profile requires
# tls-cert-pw-opt mode and any interface already on the port is unlikely to
# have it.
nae_interface_port_number: 9005
# Unlike localNode, cm_cluster's `nodes` suboptions genuinely require
# server_private_ip and server_port -- they describe the joining node to the
# cluster API rather than the connection this collection makes.
cluster_nodes:
  - server_ip: 192.168.2.101
    server_private_ip: 10.10.10.10
    server_port: 5432
    user: admin
    password: ChangeIt01!
    verify: false
    auth_domain_path:

# cm_services can only restart CipherTrust Manager, which interrupts every
# task that follows. Set this to run that test for real; by default the
# module is exercised in check mode only.
cm_allow_disruptive_tests: false

# Some targets create objects this collection cannot delete (a domain, for
# example). They are skipped unless this is set.
cm_allow_uncleanable_tests: false

# The pre-create credential tests (connection_<cloud>_test) reach the cloud
# provider from the CipherTrust Manager itself. Set this only when the manager
# has egress to the public internet, or those tasks will hang rather than fail.
cm_allow_cloud_egress_tests: false

# CCKM's AWS service reaches AWS for nearly everything it does, and creating a
# KMS key creates a billable resource in a real account. The module_cckm_aws
# target therefore runs only its reads, argument validation and check-mode
# tasks unless these are set.
#
# cckm_aws_run_live needs a CipherTrust Manager with the CCKM licence, network
# egress, and an AWS connection that already works -- create it with
# connection_aws_save and verify it with connection_test first.
cckm_aws_run_live: false
cckm_aws_connection_name: "aws-connection"
cckm_aws_account_id: "123456789012"
cckm_aws_region: "us-east-1"
# IAM users to name as key administrators in the policy template test. Leave
# empty to skip the template patch check.
cckm_aws_key_admins: []

# Creating and then scheduling deletion of a real AWS KMS key. AWS bills for
# the key until its waiting period elapses, and the shortest AWS allows is
# seven days, so this stays off unless the account is a test account.
cckm_aws_run_key_lifecycle: false

# cckm_azure_run_live needs a CipherTrust Manager with the CCKM licence,
# network egress, and an Azure connection that already works -- create one
# with connection_azure_save. Off by default: adding a vault and creating
# material in it touches a real Azure subscription.
cckm_azure_run_live: false
cckm_azure_connection_name: "azure-connection"
cckm_azure_subscription_id: "00000000-0000-0000-0000-000000000000"
